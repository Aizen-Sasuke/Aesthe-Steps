{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "AESTHÉ STEPS boutique footwear item managed live by partners.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "tagline": { "type": "string", "minLength": 1, "maxLength": 180 },
        "category": { "type": "string", "minLength": 1, "maxLength": 60 },
        "priceBDT": { "type": "number" },
        "image": { "type": "string", "minLength": 1, "maxLength": 400000 },
        "sizes": { "type": "array" },
        "outOfStockSizes": { "type": "array" },
        "oversizeAvailable": { "type": "boolean" },
        "variants": { "type": "array" },
        "badge": { "type": "string", "maxLength": 40 },
        "campaignLabel": { "type": "string", "maxLength": 80 },
        "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "details": { "type": "array" },
        "inStock": { "type": "boolean" },
        "isPublished": { "type": "boolean" },
        "rating": { "type": "number" },
        "reviewsCount": { "type": "number" },
        "sortOrder": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "name",
        "tagline",
        "category",
        "priceBDT",
        "image",
        "sizes",
        "description",
        "details",
        "inStock",
        "isPublished",
        "rating",
        "reviewsCount",
        "sortOrder",
        "updatedAt"
      ]
    },
    "StoreConfig": {
      "title": "StoreConfig",
      "description": "Publicly readable store delivery rates, active promo codes, and verified dispatch contacts.",
      "type": "object",
      "properties": {
        "insideDhakaFee": { "type": "number" },
        "outsideDhakaFee": { "type": "number" },
        "primaryPhone": { "type": "string", "minLength": 5, "maxLength": 30 },
        "secondaryPhone": { "type": "string", "minLength": 5, "maxLength": 30 },
        "whatsappNumber": { "type": "string", "minLength": 8, "maxLength": 25 },
        "email": { "type": "string", "minLength": 5, "maxLength": 120 },
        "location": { "type": "string", "minLength": 2, "maxLength": 120 },
        "partners": { "type": "string", "minLength": 2, "maxLength": 120 },
        "promoCodes": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "insideDhakaFee",
        "outsideDhakaFee",
        "primaryPhone",
        "secondaryPhone",
        "whatsappNumber",
        "email",
        "location",
        "partners",
        "promoCodes",
        "updatedAt"
      ]
    },
    "Order": {
      "title": "Order",
      "description": "Customer Cash-on-Delivery order recorded upon checkout alongside WhatsApp dispatch.",
      "type": "object",
      "properties": {
        "orderCode": { "type": "string", "minLength": 3, "maxLength": 24, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "customerName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "customerPhone": { "type": "string", "minLength": 6, "maxLength": 30 },
        "customerAddress": { "type": "string", "minLength": 4, "maxLength": 400 },
        "customerNote": { "type": "string", "maxLength": 400 },
        "deliveryArea": { "type": "string", "enum": ["inside_dhaka", "outside_dhaka"] },
        "deliveryFee": { "type": "number" },
        "promoCode": { "type": "string", "maxLength": 40 },
        "discountBDT": { "type": "number" },
        "subtotalBDT": { "type": "number" },
        "totalBDT": { "type": "number" },
        "items": { "type": "array" },
        "status": {
          "type": "string",
          "enum": ["pending", "confirmed", "dispatched", "delivered", "cancelled"]
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "orderCode",
        "customerName",
        "customerPhone",
        "customerAddress",
        "deliveryArea",
        "deliveryFee",
        "discountBDT",
        "subtotalBDT",
        "totalBDT",
        "items",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminAllowlist": {
      "title": "AdminAllowlist",
      "description": "Partner Google email allowlist authorizing access to the Admin Console.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "minLength": 5, "maxLength": 120 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "role": { "type": "string", "enum": ["partner", "owner"] },
        "addedAt": { "type": "string", "format": "date-time" },
        "addedBy": { "type": "string", "minLength": 5, "maxLength": 120 }
      },
      "required": ["email", "displayName", "role", "addedAt", "addedBy"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Footwear catalog entries; published items readable publicly, editable only by verified partners."
    },
    "/storeConfig/{configId}": {
      "schema": { "$ref": "#/entities/StoreConfig" },
      "description": "Global storefront rates, promo codes, and verified helpline metadata (/storeConfig/main)."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer Cash-on-Delivery order records; guest create allowed only with valid pending schema, PII readable/updatable solely by partners."
    },
    "/adminAllowlist/{emailId}": {
      "schema": { "$ref": "#/entities/AdminAllowlist" },
      "description": "Email-keyed access control list authorizing partner accounts."
    }
  }
}
